# Dependencies
node_modules/
jspm_packages/
web_modules/

# Generated GIR type declarations (produced by `ags types -u` from the
# typelibs installed on the local machine — regenerate rather than commit).
@girs/

# Debug logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data and diagnostic reports
pids
*.pid
*.seed
*.pid.lock

# Local environment variables (Contains sensitive API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs (Uncomment if you use TypeScript/Build tools)
# dist/
# build/

# Optional: IDE configs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

