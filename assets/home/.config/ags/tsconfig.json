{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4",

    // `ags run` reads this file and passes its paths through to esbuild. These
    // fixed home paths keep the committed strings stable while modules/ags.nix
    // updates their targets; no node_modules is needed.
    //
    // The `@girs/` sibling folder is generated by `ags types -u` from the
    // typelibs installed on this machine — it supplies the `gi://…` module
    // declarations the editor needs and is picked up automatically by the
    // default include glob. Regenerate after adding an Astal library.
    "paths": {
      "ags": ["/home/genzo/.local/share/ags/lib"],
      "ags/*": ["/home/genzo/.local/share/ags/lib/*"],
      "gnim": ["/home/genzo/.local/share/ags/node_modules/gnim/dist"],
      "gnim/*": ["/home/genzo/.local/share/ags/node_modules/gnim/dist/*"],
      "geistdesign": ["/home/genzo/.local/share/geistdesign/index.ts"]
    }
  }
}
